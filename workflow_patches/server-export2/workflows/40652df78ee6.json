    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nfor (const item of items) {\n  const data = JSON.parse(JSON.stringify(item.json || {}));\n  const line = data.line || {};\n  const targets = Array.isArray(line.targets) ? line.targets.filter(Boolean) : [];\n  const token = (line.channelAccessToken || '').trim();\n  const message = line.message;\n  if (line.enabled && token && targets.length && message) {\n    const endpoint = line.endpoint || (targets.length > 1 ? 'https://api.line.me/v2/bot/message/multicast' : 'https://api.line.me/v2/bot/message/push');\n    const payload = targets.length > 1\n      ? { to: targets, messages: [{ type: 'text', text: message }], notificationDisabled: false }\n      : { to: targets[0], messages: [{ type: 'text', text: message }], notificationDisabled: false };\n    try {\n      await this.helpers.httpRequest({ method: 'POST', url: endpoint, headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: payload, json: true });\n      data.sheetNotifiedChannel = data.sheetNotifiedChannel || (targets.length > 1 ? 'LINE(multicast)' : 'LINE(push)');\n      data.sheetStatus = data.sheetStatus || 'SMOKE_TEST_OK';\n    } catch (error) {\n      const err = error?.response?.data ? JSON.stringify(error.response.data) : (error.message || JSON.stringify(error));\n      data.sheetStatus = `${data.sheetStatus || 'SMOKE_TEST'}|LINE_ERROR`;\n      data.actionError = err;\n    }\n  }\n  if (data.line) delete data.line.channelAccessToken;\n  results.push({ json: data });\n}\nreturn results;"
      },
