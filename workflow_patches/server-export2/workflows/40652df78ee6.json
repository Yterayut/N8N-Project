    {
      "parameters": {
        "functionCode": "const now = new Date();\nconst bangkok = new Intl.DateTimeFormat('th-TH', { timeZone: 'Asia/Bangkok', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(now);\nconst isoThailand = new Date(now.getTime() + (7 * 60 * 60 * 1000)).toISOString();\nconst targets = ($env.LINE_ALERT_USER_IDS || '').split(',').map((id) => id.trim()).filter(Boolean);\nconst token = ($env.LINE_CHANNEL_ACCESS_TOKEN || '').trim() || ($env.LINE_CHANNEL_ACCESS_TOKEN_840212645843493 || '').trim() || ($env.LINE_CHANNEL_ACCESS_TOKEN_889083480945134 || '').trim();\nconst sheetNotifiedChannel = targets.length > 1 ? 'LINE(multicast)' : (targets.length === 1 ? 'LINE(push)' : '');\nreturn [{ json: {\n  sheetTimestamp: bangkok,\n  isoTimestamp: isoThailand,\n  sheetPageId: 'SMOKE_TEST_PAGE',\n  sheetPostId: 'SMOKE_TEST_POST',\n  sheetCommentId: `SMOKE_TEST_${isoThailand}`,\n  sheetUserName: 'Smoke Tester',\n  sheetUserId: targets[0] || 'SMOKE_TEST_USER',\n  sheetType: 'SMOKE_TEST',\n  sheetOriginalComment: 'Smoke test comment',\n  sheetReplyMessage: 'Smoke test reply from n8n',\n  commentUrl: 'https://example.com/smoke-test',\n  sheetStatus: 'SMOKE_TEST_OK',\n  sheetNotifiedChannel,\n  facebook: { commentUrl: 'https://example.com/smoke-test' },\n  line: {\n    enabled: Boolean(token && targets.length),\n    targets,\n    channelAccessToken: token,\n    message: `[SMOKE TEST] ${isoThailand}`\n  }\n}}];"
      },
