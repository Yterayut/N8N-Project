    {
      "parameters": {
        "jsCode": "// รับข้อมูล Event จาก Node เริ่มต้น (แก้ชื่อ 'Master Router' ถ้าท่านใช้ชื่ออื่น)\nconst event = $('Master Router').first().json.body.events[0];\nconst message = event.message;\nconst messageId = message.id;\n\n// 1. สร้างชื่อจากวันและเวลา (เช่น 2026-01-29_15-30)\nconst msgDate = new Date(event.timestamp);\n// ตั้งค่าเวลาเป็นไทย\nconst dateStr = msgDate.toLocaleString(\"en-GB\", { timeZone: \"Asia/Bangkok\", hour12: false })\n                  .replace(/\\//g, '-')   // เปลี่ยน / เป็น -\n                  .replace(/:/g, '-')    // เปลี่ยน : เป็น -\n                  .replace(', ', '_');   // เปลี่ยนช่องว่าง เป็น _\n\n// 2. ตรวจสอบประเภทไฟล์\nlet filename = `unknown_${messageId}`;\n\nif (message.type === 'image') {\n  // ตั้งชื่อรูปเป็น: วันเวลา_IMAGE.jpg\n  filename = `${dateStr}_IMAGE.jpg`; \n} \nelse if (message.type === 'file') {\n  // ถ้าเป็นไฟล์ ให้ใช้ชื่อเดิมที่คนส่งตั้งมา แต่เติมวันที่ข้างหน้า\n  const originalName = message.fileName || `file_${messageId}`;\n  filename = `${dateStr}_${originalName}`;\n}\n\n// 3. ยัดชื่อใหม่ใส่เข้าไปในไฟล์\nconst item = $input.item;\nconst binaryData = item.binary.data;\nbinaryData.fileName = filename;\n\nreturn {\n  json: {\n    original_filename: filename // ส่งชื่อไปให้ Google Drive ใช้\n  },\n  binary: {\n    data: binaryData\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3280,
        -240
      ],
