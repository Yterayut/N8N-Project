      "id": "fca8586f-d9f8-4311-b5b3-a78865f73596",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        224,
        -224
      ],
      "webhookId": "c0042c4b-a259-4a87-ac91-2cf2191da9f8"
    },
    {
      "parameters": {
        "functionCode": "const items = $input.all();\nconst results = [];\n\nconst version = ($env.FB_GRAPH_API_VERSION || 'v19.0').replace(/^v?/i, 'v');\n\nfor (const item of items) {\n  const payload = item.json.body ?? item.json;\n  const commentId = payload.commentId || payload.facebook?.commentId || '';\n  const pageId = payload.pageId || payload.facebook?.pageId || '';\n  let pageAccessToken = payload.pageAccessToken || payload.facebook?.pageAccessToken || '';\n\n  if (!pageAccessToken && pageId) {\n    const envKey = `FB_PAGE_ACCESS_TOKEN_${pageId}`;\n    pageAccessToken = ($env[envKey] || '').trim();\n  }\n  if (!pageAccessToken) {\n    pageAccessToken = ($env.FB_PAGE_ACCESS_TOKEN || '').trim();\n  }\n\n  if (!commentId || !pageAccessToken) {\n    throw new Error('commentId หรือ pageAccessToken ว่าง – กรุณาส่งค่ามาด้วย');\n  }\n\n  const url = `https://graph.facebook.com/${version}/${encodeURIComponent(commentId)}/likes`;\n\n  results.push({\n    json: {\n      commentId,\n      pageId,\n      likeUrl: url,\n      pageAccessToken\n    }\n  });\n}\n\nreturn results;\n"
      },
      "id": "904ee623-3b6a-4cac-88a9-fe126b292447",
      "name": "Prepare Like Request",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        496,
        -224
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.likeUrl }}",
