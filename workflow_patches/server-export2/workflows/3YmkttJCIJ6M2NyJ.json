    {
      "parameters": {
        "jsCode": "// Extract Gemini response\nconst response = $input.item.json.candidates[0].content.parts[0].text;\n\nreturn {\n  geminiResponse: response,\n  commentId: $input.item.json.commentId,\n  originalComment: $input.item.json.message,\n  commenterName: $input.item.json.from.name\n};"
      },
