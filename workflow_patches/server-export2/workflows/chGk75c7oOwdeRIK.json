    {
      "parameters": {
        "sendTo": "support-oneclimate@one.th",
        "subject": "มีลูกค้าประเมินความพึงพอใจมา !!!!!!!",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n<style>\n  body { font-family: 'Sarabun', sans-serif; color: #333; line-height: 1.6; }\n  .container { max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; }\n  .header { background-color: #005f73; color: white; padding: 20px; text-align: center; }\n  .content { padding: 20px; background-color: #ffffff; }\n  .score-box { background-color: #f8f9fa; padding: 15px; border-radius: 5px; border-left: 5px solid #0a9396; margin-bottom: 20px; }\n  .section-title { font-size: 16px; font-weight: bold; color: #005f73; margin-top: 15px; border-bottom: 1px solid #ddd; padding-bottom: 5px; }\n  .table-score { width: 100%; border-collapse: collapse; margin-top: 10px; }\n  .table-score td { padding: 8px; border-bottom: 1px solid #eee; }\n  .table-score td:last-child { font-weight: bold; text-align: right; }\n  .badge { display: inline-block; padding: 5px 10px; border-radius: 4px; color: white; font-weight: bold; font-size: 14px; }\n  .badge-bad { background-color: #ae2012; }\n  .badge-neutral { background-color: #ee9b00; }\n  .badge-good { background-color: #0a9396; }\n  \n  /* CSS กล่องข้อมูลลูกค้า */\n  .customer-info { background-color: #e3f2fd; border-radius: 6px; padding: 12px; margin-bottom: 20px; border: 1px solid #bbdefb; }\n  .info-row { display: flex; justify-content: space-between; margin-bottom: 4px; }\n  .info-label { color: #555; font-size: 14px; }\n  .info-value { font-weight: bold; color: #005f73; font-size: 14px; text-align: right; }\n\n  ul { margin-top: 5px; padding-left: 20px; }\n</style>\n</head>\n<body>\n\n<div class=\"container\">\n  <div class=\"header\">\n    <h2 style=\"margin:0;\">Oneclimate Customer Feedback</h2>\n    <p style=\"margin:5px 0 0;\">รายงานสรุปผลความพึงพอใจลูกค้า</p>\n  </div>\n\n  <div class=\"content\">\n    <p>เรียน ทีมงาน,</p>\n    \n    <p>มีลูกค้าทำแบบประเมินเข้ามาใหม่ โดยภาพรวมอยู่ในระดับ: \n      <span class=\"badge {{ $('Edit Fields').item.json.analysis.overall_sentiment_level.includes('แย่') ? 'badge-bad' : ($('Edit Fields').item.json.analysis.overall_sentiment_level.includes('พอใช้') ? 'badge-neutral' : 'badge-good') }}\">\n        {{ $('Edit Fields').item.json.analysis.overall_sentiment_level }}\n      </span>\n    </p>\n\n    <div class=\"customer-info\">\n        <div style=\"font-size: 12px; color: #888; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;\">👤 ข้อมูลผู้ให้ข้อมูล (Respondent)</div>\n        \n        <div class=\"info-row\">\n            <span class=\"info-label\">ชื่อ/บริษัท:</span>\n            <span class=\"info-value\">{{ $('Webhook').item.json.body.name || '-' }}</span> \n        </div>\n        \n        <div class=\"info-row\">\n            <span class=\"info-label\">เบอร์โทรศัพท์:</span>\n            <span class=\"info-value\">{{ $('Webhook').item.json.body.phone || '-' }}</span>\n        </div>\n\n        <div class=\"info-row\" style=\"margin-bottom: 0;\">\n             <span class=\"info-label\">วันที่ส่งข้อมูล:</span>\n             <span class=\"info-value\">{{ $now.toFormat('dd/MM/yyyy HH:mm') }}</span>\n        </div>\n    </div>\n    <div class=\"score-box\">\n      <strong>📝 บทสรุปผู้บริหาร (Summary):</strong><br>\n      {{ $('Edit Fields').item.json.analysis.summary_thai }}\n    </div>\n\n    <div class=\"section-title\">📊 คะแนนการประเมิน (Scoring)</div>\n    <table class=\"table-score\">\n      <tr>\n        <td>ระบบ (Service)</td>\n        <td>{{ $('Edit Fields').item.json.calculations.section_1_service_percent }}%</td>\n      </tr>\n      <tr>\n        <td>การให้บริการ (Support)</td>\n        <td>{{ $('Edit Fields').item.json.calculations.section_2_support_percent }}%</td>\n      </tr>\n      <tr>\n        <td>ภาพรวม (Overall)</td>\n        <td>{{ $('Edit Fields').item.json.calculations.section_3_overall_percent }}%</td>\n      </tr>\n      <tr style=\"background-color: #f0f0f0;\">\n        <td><strong>คะแนนเฉลี่ยรวม (เต็ม 5)</strong></td>\n        <td><strong>{{ $('Edit Fields').item.json.calculations.total_average_score }} / 5.00</strong></td>\n      </tr>\n    </table>\n\n    <div class=\"section-title\">👍 จุดแข็ง (Strengths)</div>\n    <ul>\n      {{ $('Edit Fields').item.json.analysis.strengths_thai.map(item => \"<li>\" + item + \"</li>\").join(\"\") }}\n    </ul>\n\n    <div class=\"section-title\">👎 จุดที่ควรปรับปรุง (Weaknesses)</div>\n    <ul>\n      {{ $('Edit Fields').item.json.analysis.weaknesses_thai.map(item => \"<li>\" + item + \"</li>\").join(\"\") }}\n    </ul>\n\n    <div class=\"section-title\">💡 ข้อเสนอแนะ (Suggestion)</div>\n    <p style=\"background-color: #e9f5f5; padding: 10px; border-radius: 4px;\">\n      {{ $('Edit Fields').item.json.analysis.suggestion_thai }}\n    </p>\n\n    <hr style=\"border: 0; border-top: 1px solid #eee; margin-top: 30px;\">\n    <p style=\"font-size: 12px; color: #999; text-align: center;\">\n      This email was sent automatically by Oneclimate Automation System (n8n).\n    </p>\n  </div>\n</div>\n\n</body>\n</html>",
        "options": {}
