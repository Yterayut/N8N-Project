# Secrets and credentials
.env
.env.dev
.env.local
.env.test
.env.prod
.env.backup*
.env.bak*
.env.current
.env.restore
!.env.example
.env.facebook_tokens

# OS and editor files
.DS_Store
.vscode/
._*

# Editor swap files
*.swp
*.swo

# ngrok/cache/tmp
.cache/
*.log

