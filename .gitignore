# SQLite databases
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite.bak*

# Backup files
backups/
logs/

# Agent worktrees (top-level only)
/agents/
# Allow .claude/agents/ sub-agents
!.claude/agents/
!.claude/agents/**
.tmp/
cookie.txt
tmp/
